{
  "name": "redx-md-bot",
  "description": "REDx MD Bot (formerly REDXBOT302) — WhatsApp Multi-Device bot by Abdul Rehman Rajpoot",
  "keywords": [
    "redx-md-bot",
    "redx-md",
    "redxbot302",
    "whatsapp",
    "whatsapp-bot",
    "whatsapp-multi-device",
    "baileys",
    "abdul-rehman-rajpoot"
  ],
  "repository": "https://github.com/AbdulRehman19721986/REDXBOT-MD",
  "env": {
    "SESSION_ID": {
      "description": "Put your session id here (from https://redxpair3.vercel.app)",
      "required": true,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number (without +)",
      "required": true,
      "value": "3009842133"
    },
    "BOT_NAME": {
      "description": "Bot name",
      "required": false,
      "value": "REDx MD Bot"
    },
    "PREFIX": {
      "description": "Command prefix",
      "required": false,
      "value": "."
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/DuckyTeam/heroku-buildpack-imagemagick.git"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
